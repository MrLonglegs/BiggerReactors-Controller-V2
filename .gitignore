# Lua / ComputerCraft .gitignore

# Common Lua build artifacts
*.o
*.so
*.a
*.lib
*.dll

# Compiled Lua bytecode
*.luac

# LuaJIT
*.lua.bak

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~

# IDE / Editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.cproject
*.project
*.settings/
*.projectile
*.tmproj

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Build output directories
build/
dist/
out/
bin/
obj/

# Log files
*.log
logs/

# Configuration files (user-specific)
config.local.lua
*.local.cfg

# ComputerCraft / CC-Tweaked specific
cc-out/
cc-debug/
*.cclog

# Debug artifacts
*.dump
*.stacktrace